# Copy to .env. Values below are local defaults, not production secrets.

# --- Shared Postgres (Chatwoot + g01 + pgvector) ---
POSTGRES_USER=g01
POSTGRES_PASSWORD=g01
POSTGRES_DB=chatwoot

# --- Chatwoot (upstream image; core messaging and auth stay in Rails) ---
# Alphanumeric, at least 63 characters. Chatwoot rejects symbols.
SECRET_KEY_BASE=G01devSecretKeyBase0123456789abcdefghijklmnopqrstuvwxyzABCDEF
FRONTEND_URL=http://localhost:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# --- Jane sidecar ---
G01_DATABASE_URL=postgresql+asyncpg://g01:g01@postgres:5432/chatwoot
G01_REDIS_URL=redis://redis:6379/1
G01_ALLOW_MEMORY_STORE=0
G01_BOOT_ON_STARTUP=1
G01_SEED_DEMO=0
# Sidekiq calls this URL. Inside Compose it is the jane service, not the browser.
G01_PUBLIC_BASE_URL=http://jane:8000
# Local default. Replace this before the machine is reachable by anyone else.
G01_ADMIN_TOKEN=g01-local-admin-token
# Creates Ada Yard and Bea Chenier on boot, plus the conversation between them.
G01_SEED_HOMESTEADERS=1

# Google GenAI. Flash = live turns. Pro = deliberation and poll synthesis. Embeddings = 768-d.
G01_GEMINI_API_KEY=
G01_GEMINI_CHAT_MODEL=gemini-2.5-flash
G01_GEMINI_DELIBERATION_MODEL=gemini-2.5-pro
G01_GEMINI_EMBEDDING_MODEL=text-embedding-004

# Chatwoot REST access for Jane
G01_CHATWOOT_BASE_URL=http://rails:3000
G01_CHATWOOT_PUBLIC_URL=http://localhost:3000
G01_CHATWOOT_ACCOUNT_ID=1
G01_CHATWOOT_API_TOKEN=
G01_CHATWOOT_PLATFORM_TOKEN=
G01_CHATWOOT_INBOX_ID=1
G01_CHATWOOT_WEBHOOK_SECRET=
G01_JANE_USER_ID=1

# Stripe sponsorship + Identity KYC
G01_STRIPE_SECRET_KEY=
G01_STRIPE_WEBHOOK_SECRET=
G01_STRIPE_SPONSOR_PRICE_ID=
G01_STRIPE_SUCCESS_URL=http://localhost:3000
G01_STRIPE_CANCEL_URL=http://localhost:3000
