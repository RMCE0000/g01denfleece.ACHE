# Copy to .env on the Google Cloud VM. Replace every placeholder before starting.
# Keep this file off the VM's git history. .env is gitignored.

# --- Shared Postgres (Chatwoot + g01 + pgvector) ---
POSTGRES_USER=g01
# openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=chatwoot

# --- Chatwoot ---
# openssl rand -hex 64
# Alphanumeric, at least 63 characters. Chatwoot rejects symbols.
SECRET_KEY_BASE=replace-with-openssl-rand-hex-64
FRONTEND_URL=https://g01denfleece.com
# Let's Encrypt account mail. Certificate expiry notices go here.
ACME_EMAIL=you@example.com

# Use a transactional SMTP provider for reset mail. Microsoft 365 password
# SMTP is temporary and may already be disabled by tenant Security Defaults.
SMTP_ADDRESS=replace-with-smtp-host
SMTP_PORT=587
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_AUTHENTICATION=login
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_DOMAIN=g01denfleece.com
MAILER_SENDER_EMAIL=Jane <jane@g01denfleece.com>

CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# --- Jane sidecar ---
G01_DATABASE_URL=postgresql+asyncpg://g01:replace-with-openssl-rand-hex-24@postgres:5432/chatwoot
G01_REDIS_URL=redis://redis:6379/1
G01_ALLOW_MEMORY_STORE=0
G01_BOOT_ON_STARTUP=1
G01_SEED_DEMO=0
G01_PUBLIC_BASE_URL=http://jane:8000
# openssl rand -hex 32
G01_ADMIN_TOKEN=replace-with-openssl-rand-hex-32
# Use a different value from G01_ADMIN_TOKEN: openssl rand -hex 32
G01_BRIDGE_SECRET=replace-with-a-second-openssl-rand-hex-32
# Known demo passwords stay off the public machine.
G01_SEED_HOMESTEADERS=0

G01_BACKGROUND_JOBS=0
G01_DAILY_POLL_ENABLED=1
G01_POLL_TIMEZONE=America/Chicago
G01_DEMAND_POLL_SCHEDULER_INTERVAL_SECONDS=300
G01_AUTOMATIC_MATCHMAKING_ENABLED=1
G01_COLLABORATION_SCHEDULER_INTERVAL_SECONDS=300

G01_GEMINI_API_KEY=replace-with-google-ai-studio-api-key
G01_GEMINI_CHAT_MODEL=gemini-3.5-flash
G01_GEMINI_DELIBERATION_MODEL=gemini-3.1-pro-preview
G01_GEMINI_EMBEDDING_MODEL=gemini-embedding-2
G01_AUDIO_TRANSCRIPTION_ENABLED=1
G01_AUDIO_TRANSCRIPTION_MAX_BYTES=10000000
G01_MATCH_SIMILARITY_THRESHOLD=0.82

G01_CHATWOOT_BASE_URL=http://rails:3000
G01_CHATWOOT_PUBLIC_URL=https://g01denfleece.com
G01_CHATWOOT_ACCOUNT_ID=1
G01_CHATWOOT_API_TOKEN=
G01_CHATWOOT_PLATFORM_TOKEN=
G01_CHATWOOT_INBOX_ID=1
# Authenticates Chatwoot's internal message webhook: openssl rand -hex 32
G01_CHATWOOT_WEBHOOK_SECRET=replace-with-openssl-rand-hex-32
G01_JANE_USER_ID=1

G01_STRIPE_SECRET_KEY=replace-with-sk-live-or-test-key
G01_STRIPE_WEBHOOK_SECRET=replace-with-whsec-signing-secret
G01_STRIPE_SPONSOR_PRICE_ID=replace-with-price-id
G01_STRIPE_SUCCESS_URL=https://g01denfleece.com
G01_STRIPE_CANCEL_URL=https://g01denfleece.com
